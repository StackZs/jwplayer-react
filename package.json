{
  "name": "@stackzs/jwplayer-react",
  "version": "1.2.2",
  "description": "A react component that creates an instance of JW Player, updated for React 18",
  "license": "MIT",
  "author": "Zachary Haigh (updated by StackZs)",
  "homepage": "https://github.com/StackZs/jwplayer-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StackZs/jwplayer-react.git"
  },
  "bugs": {
    "url": "https://github.com/StackZs/jwplayer-react/issues"
  },
  "main": "./lib/jwplayer-react.js",
  "scripts": {
    "build": "webpack && npm run badges:build:passing || npm run badges:build:failing",
    "ci": "npm ci; npm run build; npm run test; npm run lint; npm run badges:license",
    "lint": "eslint ./src/**/* --fix",
    "test": "jest --coverage && npm run badges:coverage && npm run badges:test:passing || npm run badges:test:failing",
    "badges:build:passing": "badge build passing :brightgreen > ./badges/build.svg",
    "badges:build:failing": "badge build failing :red > ./badges/build.svg",
    "badges:coverage": "node ./badges/util/coverage.js",
    "badges:test:passing": "badge tests passing :brightgreen > ./badges/test.svg",
    "badges:test:failing": "badge tests failing :red > ./badges/test.svg",
    "badges:license": "badge license MIT :brightgreen > ./badges/license.svg"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0",
    "react-dom": "^17.0.2 || ^18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@testing-library/react": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "badge-maker": "^3.3.1",
    "eslint": "^8.52.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "jsdom": "^22.1.0",
    "mri": "^1.2.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "jw",
    "jwplayer",
    "player",
    "react",
    "react-18"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*"
    ],
    "coverageReporters": [
      "json-summary"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
